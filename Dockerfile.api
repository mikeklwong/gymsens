FROM python:3.11-slim
WORKDIR /app
COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt
COPY gymsens_learning.py gymsens_api.py ./
RUN useradd --create-home --uid 10001 gymsens && mkdir /data && chown gymsens:gymsens /data
USER gymsens
ENV GYMSENS_DATA_DIR=/data
EXPOSE 8000
CMD ["uvicorn", "gymsens_api:app", "--host", "0.0.0.0", "--port", "8000"]
