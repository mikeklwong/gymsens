# Change this before exposing a server. Keep secrets in env/secret manager, not Git.
GYMSENS_DATA_DIR=data
# Replace the sample key with a strong randomly generated value (>=16 chars).
GYMSENS_API_KEYS_JSON={}
# Only include your authorized browser origin(s); native mobile app uses your backend.
GYMSENS_CORS_ORIGINS=
GYMSENS_API_STALE_SECONDS=12
